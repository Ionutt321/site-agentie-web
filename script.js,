document.addEventListener("DOMContentLoaded", () => {
    // 1. Efectul de fundal pentru meniul de navigare la scroll
    const navbar = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
        if (navbar) {
            if (window.scrollY > 50) navbar.classList.add('scrolled');
            else navbar.classList.remove('scrolled');
        }
    });

    // 2. Deschiderea Modalului de Contact / Cere Ofertă
    window.openModal = function(packageName = 'Contact General', price = 0) {
        document.getElementById('checkout-modal').classList.add('show');
        const notes = document.getElementById('order-notes');
        
        if (notes) {
            // Precompletăm ascuns pachetul ales de client, dacă a dat click pe un card anume
            if (packageName !== 'Contact General') {
                notes.value = `Pachet vizat: ${packageName} (Preț pornire: ${price} Lei)`;
            } else {
                notes.value = 'Cerere Ofertă Generală';
            }
        }
    };

    // 3. Trimiterea Formularului Principal de Lead-uri (Cere Ofertă)
    const checkoutForm = document.getElementById('checkout-form');
    if (checkoutForm) {
        checkoutForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = document.getElementById('btn-submit-order');
            submitBtn.disabled = true; 
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Se trimite...';

            const orderData = {
                customerName: document.getElementById('order-name').value.trim(),
                customerPhone: document.getElementById('order-phone').value.trim(),
                projectDescription: document.getElementById('order-address').value.trim(),
                packageInterested: document.getElementById('order-notes').value.trim(),
                status: 'lead_nou', 
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            };

            try {
                // Salvează cererea în baza de date Firebase (colecția orders)
                await firebase.firestore().collection('orders').add(orderData);
                
                // Trimite evenimentul de conversie către Google Analytics
                if (typeof gtag === 'function') {
                    gtag('event', 'generate_lead', { currency: 'RON', value: 100 });
                }
                
                // Mesaj de succes pe ecran
                checkoutForm.innerHTML = `
                    <div style="text-align:center; padding: 20px 0;">
                        <i class="fas fa-check-circle" style="font-size:4.5rem; color:var(--success); margin-bottom:20px;"></i>
                        <h2 style="color:var(--text-main); font-size: 1.8rem; margin-bottom: 10px;">Cererea a fost trimisă!</h2>
                        <p style="color:var(--text-muted); font-size: 1.1rem;">Îți mulțumim! Un expert din echipa Nexora va analiza proiectul tău și te va contacta în scurt timp.</p>
                        <button type="button" onclick="document.getElementById('checkout-modal').classList.remove('show'); location.reload();" class="btn-primary" style="margin-top:25px; width:100%; padding: 14px;">Închide</button>
                    </div>
                `;
            } catch (error) {
                console.error("Eroare la trimitere:", error);
                submitBtn.disabled = false; 
                submitBtn.innerHTML = 'Eroare. Încearcă din nou!';
            }
        });
    }

    // 4. Trimiterea Formularului de "Audit Gratuit" din Footer
    const footForm = document.getElementById('footer-form');
    if (footForm) {
        footForm.addEventListener('submit', async (e) => { 
            e.preventDefault(); 
            const btn = footForm.querySelector('button');
            btn.disabled = true; 
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Se trimite...';
            
            try {
                await firebase.firestore().collection('subscribers').add({ 
                    name: document.getElementById('foot-name').value.trim(), 
                    email: document.getElementById('foot-email').value.trim(), 
                    type: 'solicitare_audit_gratuit',
                    createdAt: firebase.firestore.FieldValue.serverTimestamp() 
                });
                
                footForm.innerHTML = `
                    <div style="text-align:center; background: rgba(16, 185, 129, 0.1); padding: 15px; border-radius: 8px; border: 1px solid #10b981;">
                        <h3 style="color:#10b981; margin-bottom: 5px;"><i class="fas fa-check"></i> Audit Solicitat!</h3>
                        <p style="color: var(--text-main); font-size:0.9rem;">Verifică-ți adresa de email în curând.</p>
                    </div>`;
            } catch(err) { 
                console.error("Eroare audit:", err);
                btn.disabled = false; 
                btn.innerHTML = 'Eroare. Reîncearcă'; 
            }
        });
    }
});
