document.addEventListener("DOMContentLoaded", () => {
    // 1. Navbar Scroll Effect
    const navbar = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
        if (navbar) {
            if (window.scrollY > 50) navbar.classList.add('scrolled');
            else navbar.classList.remove('scrolled');
        }
    });

    // 2. Chatbot AI UI Toggle
    const chatWidget = document.getElementById('chatbot-widget');
    const chatHeader = document.getElementById('chat-toggle');
    const chatIcon = document.getElementById('chat-icon');
    if (chatHeader && chatWidget) {
        chatHeader.addEventListener('click', () => {
            chatWidget.classList.toggle('open');
            chatIcon.classList.toggle('fa-chevron-down');
            chatIcon.classList.toggle('fa-chevron-up');
        });
    }

    // 3. Chatbot Logic & API Call
    const chatInput = document.getElementById('chat-input');
    const chatSendBtn = document.getElementById('chat-send');
    const chatLogs = document.getElementById('chat-logs');
    let messageHistory = []; 

    async function sendChatMessage() {
        const text = chatInput.value.trim();
        if (!text) return;
        
        chatLogs.innerHTML += `<div class="msg user">${text}</div>`;
        chatInput.value = '';
        chatLogs.scrollTop = chatLogs.scrollHeight; 
        messageHistory.push({ role: "user", content: text });

        const loadingId = 'load-' + Date.now();
        chatLogs.innerHTML += `<div id="${loadingId}" class="msg bot" style="color:#64748b;"><i class="fas fa-ellipsis-h fa-fade"></i> Procesare...</div>`;
        chatLogs.scrollTop = chatLogs.scrollHeight;

        try {
            const availableProducts = (window.dbProductsList || []).map(p => `${p.name} - Preț estimativ: ${p.price} Euro`).join('\n');

            const response = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    messages: messageHistory,
                    currentMenu: availableProducts
                })
            });
            const data = await response.json();
            document.getElementById(loadingId).remove();
            
            if (data.reply) {
                const botReply = data.reply.trim().replace(/\n/g, '<br>');
                chatLogs.innerHTML += `<div class="msg bot">${botReply}</div>`;
                messageHistory.push({ role: "assistant", content: data.reply }); 
            } else {
                chatLogs.innerHTML += `<div class="msg bot" style="color:red;">Scuze, a apărut o problemă de conexiune.</div>`;
            }
            chatLogs.scrollTop = chatLogs.scrollHeight;
        } catch (err) {
            document.getElementById(loadingId).remove();
            chatLogs.innerHTML += `<div class="msg bot" style="color:red;">Eroare de server. Ne poți contacta direct prin formular.</div>`;
            chatLogs.scrollTop = chatLogs.scrollHeight;
        }
    }
    
    if (chatSendBtn) chatSendBtn.addEventListener('click', sendChatMessage);
    if (chatInput) chatInput.addEventListener('keypress', (e) => { if(e.key === 'Enter') sendChatMessage(); });

    // 4. Modal Contact (Generare Lead-uri)
    window.openModal = function(packageName = 'Contact General', price = 0) {
        document.getElementById('checkout-modal').classList.add('show');
        const notes = document.getElementById('order-notes');
        if(notes) {
            notes.value = packageName !== 'Contact General' ? `Pachet vizat: ${packageName} (${price}€)` : '';
        }
    };

    // 5. Submit Formular "Cere Ofertă" (Creează comanda în Firebase)
    const checkoutForm = document.getElementById('checkout-form');
    if (checkoutForm) {
        checkoutForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = document.getElementById('btn-submit-order');
            submitBtn.disabled = true; submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Se trimite...';

            const orderData = {
                customerName: document.getElementById('order-name').value.trim(),
                customerPhone: document.getElementById('order-phone').value.trim(),
                projectDescription: document.getElementById('order-address').value.trim(),
                notes: document.getElementById('order-notes').value.trim(),
                status: 'lead_nou', 
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            };

            try {
                // Trimite datele în colecția 'orders' din Firebase
                await firebase.firestore().collection('orders').add(orderData);
                
                // Track Google Analytics lead
                if (typeof gtag === 'function') gtag('event', 'generate_lead', { currency: 'EUR', value: 100 });
                
                // Mesaj de succes
                checkoutForm.innerHTML = `
                    <div style="text-align:center; padding: 20px 0;">
                        <i class="fas fa-check-circle" style="font-size:4rem; color:var(--success); margin-bottom:15px;"></i>
                        <h2 style="color:var(--text-main);">Cererea a fost trimisă!</h2>
                        <p style="color:var(--text-muted); margin-top:10px;">Îți mulțumim! Un expert din echipa Nexora te va contacta în 24h.</p>
                        <button type="button" onclick="document.getElementById('checkout-modal').classList.remove('show'); location.reload();" class="btn-primary" style="margin-top:20px; width:100%;">Închide</button>
                    </div>
                `;
            } catch (error) {
                console.error(error);
                submitBtn.disabled = false; submitBtn.innerHTML = 'Eroare. Încearcă din nou!';
            }
        });
    }

    // 6. Submit Formular "Audit Gratuit" din Footer
    const footForm = document.getElementById('footer-form');
    if(footForm) {
        footForm.addEventListener('submit', async (e) => { 
            e.preventDefault(); 
            const btn = footForm.querySelector('button');
            btn.disabled = true; btn.innerHTML = 'Se trimite...';
            try {
                await firebase.firestore().collection('subscribers').add({ 
                    name: document.getElementById('foot-name').value.trim(), 
                    email: document.getElementById('foot-email').value.trim(), 
                    type: 'solicitare_audit',
                    createdAt: firebase.firestore.FieldValue.serverTimestamp() 
                });
                footForm.innerHTML = '<h3 style="color:#10b981; text-align:center;"><i class="fas fa-check"></i> Audit Solicitat!</h3><p style="text-align:center; font-size:0.9rem;">Te vom contacta pe email.</p>';
            } catch(err) { btn.disabled = false; btn.innerHTML = 'Eroare'; }
        });
    }
});
